{
  "name": "lonely-lights/prosetta",
  "description": "Prosetta key management is a Laravel package for managing key-based translations.",
  "type": "project",
  "license": "MIT",

  "homepage": "https://github.com/andrewkhartley/prosetta",
  "authors": [
    {
      "name": "Andrew K. Hartley",
      "homepage": "https://andrewkhartley.com",
      "email": "andrew@andrewkhartley.com",
      "role": "Creator"
    }
  ],

  "require": {
    "php": "^8.2",
    "laravel/framework": "^10.0|^11.0",
    "ezyang/htmlpurifier": "^4.17"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "LonelyLights\\Prosetta\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LonelyLights\\Prosetta\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "LonelyLights\\Prosetta\\ProsettaServiceProvider"
      ],
      "branch-alias": {
        "dev-main": "1.0-dev"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
