{
    "name": "lonely-lights/prosetta",
    "description": "Translate a Laravel app with AI, review each language, and write the approved text back into your lang files.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "translation",
        "i18n",
        "localization",
        "ai",
        "lang-files",
        "review"
    ],
    "homepage": "https://github.com/lonely-lights/prosetta",
    "authors": [
        {
            "name": "Andrew K. Hartley",
            "homepage": "https://andrewkhartley.com",
            "email": "andrew@andrewkhartley.com",
            "role": "Creator"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.1",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0|^5.0"
    },
    "suggest": {
        "laravel/ai": "A ready-made AI client for writing your TranslationDriver (see docs/ai-drivers.md)"
    },
    "autoload": {
        "psr-4": {
            "LonelyLights\\Prosetta\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LonelyLights\\Prosetta\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LonelyLights\\Prosetta\\ProsettaServiceProvider"
            ],
            "aliases": {
                "Prosetta": "LonelyLights\\Prosetta\\Facades\\Prosetta"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "email": "opensource@lonelylights.com",
        "issues": "https://github.com/lonely-lights/prosetta/issues",
        "source": "https://github.com/lonely-lights/prosetta"
    }
}
